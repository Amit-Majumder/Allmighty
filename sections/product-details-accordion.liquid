{% comment %}
  Product details accordion — custom section
  Renders the product Description plus every populated metafield (configurable
  namespace) as Dawn-styled collapsibles.
{% endcomment %}

{% liquid
  assign namespace = section.settings.metafield_namespace | default: 'custom'
%}

<section class="section color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="product__info-wrapper">
      <div class="product__info-container">
        <accordion-group class="product__accordions">
          {%- if section.settings.show_description and product.description != blank -%}
            <details class="product__accordion accordion quick-add-hidden"{% if section.settings.description_open %} open{% endif %}>
              <summary>
                <div class="summary__title">
                  <h2 class="h4 accordion__title inline-richtext">{{ section.settings.description_heading }}</h2>
                </div>
                {% comment %}<span class="accordion__chevron" aria-hidden="true">{% render 'icon-caret' %}</span>{% endcomment %}
              </summary>
              <div class="accordion__content rte" id="ProductAccordion-description-{{ section.id }}">
                {{ product.description }}
              </div>
            </details>
          {%- endif -%}

          {%- if product.metafields[namespace] != blank -%}
            {%- for metafield in product.metafields[namespace] -%}
              {%- if metafield.value == blank -%}
                {%- continue -%}
              {%- endif -%}
              {%- assign label = metafield.label | default: metafield.key | capitalize -%}
              <details class="product__accordion accordion quick-add-hidden">
                <summary>
                  <div class="summary__title">
                    <h2 class="h4 accordion__title inline-richtext">{{ label | escape }}</h2>
                  </div>
                  {%- render 'icon-caret' -%}
                </summary>
                <div class="accordion__content rte" id="ProductAccordion-{{ metafield.key }}-{{ section.id }}">
                  {{ metafield.value }}
                </div>
              </details>
            {%- endfor -%}
          {%- endif -%}
        </accordion-group>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product details accordion",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "metafield_namespace",
      "label": "Metafield namespace",
      "default": "custom",
      "info": "Show all populated metafields from this namespace on the product, each as its own collapsible."
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show description",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "description_open",
      "label": "Open description by default",
      "default": true
    },
    {
      "type": "text",
      "id": "description_heading",
      "label": "Description heading",
      "default": "Description"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Product details accordion"
    }
  ]
}
{% endschema %}
