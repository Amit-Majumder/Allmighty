<div
  class="giva-cat color-{{ section.settings.color_scheme }} gradient"
  style="padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;"
>
  <div class="page-width">
    {%- if section.settings.eyebrow != blank or section.settings.title != blank -%}
      <div class="giva-section-head giva-section-head--center">
        {%- if section.settings.eyebrow != blank -%}
          <p class="giva-section-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 class="giva-section-title {{ section.settings.heading_size }}">{{ section.settings.title | escape }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="giva-cat__scroller" data-cat-scroller>
        <button
          type="button"
          class="giva-cat__arrow giva-cat__arrow--prev"
          name="previous"
          aria-label="Scroll categories left"
          disabled
        >
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </button>
        <div class="giva-cat__grid">
        {%- for block in section.blocks -%}
          <div class="giva-cat__item" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="giva-cat__link">
            {%- else -%}
              <div class="giva-cat__link">
            {%- endif -%}
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      widths: '360, 540, 720, 900',
                      class: 'giva-cat__image'
                  }}
                {%- else -%}
                  {{ 'collection-1' | placeholder_svg_tag: 'giva-cat__image giva-cat__image--placeholder' }}
                {%- endif -%}
                {%- if block.settings.title != blank -%}
                  <span class="giva-cat__title">{{ block.settings.title | escape }}</span>
                {%- endif -%}
            {%- if block.settings.link != blank -%}
              </a>
            {%- else -%}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
        </div>
        <button
          type="button"
          class="giva-cat__arrow giva-cat__arrow--next"
          name="next"
          aria-label="Scroll categories right"
        >
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </button>
      </div>
    {%- endif -%}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('[data-cat-scroller]').forEach(function (scroller) {
      var grid = scroller.querySelector('.giva-cat__grid');
      var prev = scroller.querySelector('.giva-cat__arrow--prev');
      var next = scroller.querySelector('.giva-cat__arrow--next');
      if (!grid || !prev || !next) return;

      function update() {
        var maxLeft = grid.scrollWidth - grid.clientWidth;
        prev.disabled = grid.scrollLeft <= 1;
        next.disabled = grid.scrollLeft >= maxLeft - 1;
      }

      function step() {
        var card = grid.querySelector('.giva-cat__item');
        if (!card) return grid.clientWidth;
        var gap = 0;
        var columnGap = window.getComputedStyle(grid).columnGap;
        if (columnGap) gap = parseFloat(columnGap) || 0;
        return card.offsetWidth + gap;
      }

      prev.addEventListener('click', function () {
        grid.scrollBy({ left: -step(), behavior: 'smooth' });
      });

      next.addEventListener('click', function () {
        grid.scrollBy({ left: step(), behavior: 'smooth' });
      });

      grid.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
      update();
    });
  });
</script>

{% schema %}
{
  "name": "GIVA - Category grid",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "info": "Small uppercase label above the heading."
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Shop by Category"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h3",
          "label": "Small"
        },
        {
          "value": "h2",
          "label": "Medium"
        },
        {
          "value": "h1",
          "label": "Large"
        }
      ],
      "default": "h2",
      "label": "Heading size"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colors",
      "default": "scheme-3"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 44
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 44
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Label",
          "default": "Category"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GIVA - Category grid",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "title": "Rings"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Earrings"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Bracelets"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Pendants"
          }
        }
      ]
    }
  ]
}
{% endschema %}
