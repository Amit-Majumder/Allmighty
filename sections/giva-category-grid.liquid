<div
  class="giva-cat color-{{ section.settings.color_scheme }} gradient"
  style="padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;"
>
  <div class="page-width">
    {%- if section.settings.eyebrow != blank or section.settings.title != blank -%}
      <div class="giva-section-head giva-section-head--center">
        {%- if section.settings.eyebrow != blank -%}
          <p class="giva-section-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 class="giva-section-title {{ section.settings.heading_size }}">{{ section.settings.title | escape }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="giva-cat__grid">
        {%- for block in section.blocks -%}
          <div class="giva-cat__item" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="giva-cat__link">
            {%- else -%}
              <div class="giva-cat__link">
            {%- endif -%}
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      widths: '360, 540, 720, 900',
                      sizes: '(min-width: 1200px) 20vw, (min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw',
                      class: 'giva-cat__image'
                  }}
                {%- else -%}
                  {{ 'collection-1' | placeholder_svg_tag: 'giva-cat__image giva-cat__image--placeholder' }}
                {%- endif -%}
            {%- if block.settings.link != blank -%}
              </a>
            {%- else -%}
              </div>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <span class="giva-cat__title">{{ block.settings.title | escape }}</span>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "GIVA - Category grid",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "info": "Small uppercase label above the heading."
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Shop by Category"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h3",
          "label": "Small"
        },
        {
          "value": "h2",
          "label": "Medium"
        },
        {
          "value": "h1",
          "label": "Large"
        }
      ],
      "default": "h2",
      "label": "Heading size"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colors",
      "default": "scheme-3"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 44
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 44
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Label",
          "default": "Category"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GIVA - Category grid",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "title": "Rings"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Earrings"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Bracelets"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Pendants"
          }
        }
      ]
    }
  ]
}
{% endschema %}
