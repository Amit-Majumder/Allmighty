{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding isolate{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    {%- if section.settings.heading != blank -%}
      <h2 class="customer-reviews__heading inline-richtext {{ section.settings.heading_size }}">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    <div style="clear:both"></div>
    <div
      id="judgeme_product_reviews"
      class="jdgm-widget jdgm-review-widget"
      data-product-title="{{ product.title | escape }}"
      data-id="{{ product.id }}"
      data-product-id="{{ product.id }}"
      data-widget="review"
      data-shop-reviews="false"
      data-shop-reviews-count="0"
      data-cart-eligible-template="false"
      data-shop-average-rating="0.00"
      data-shop-review-count="0"
      data-empty-state="empty_widget"
      data-preview-mode="sample_data"
      data-entry-point="review_widget.js"
      data-entry-key="review-widget/main.js"
      data-customer-logged-in="false"
      style="max-width:1200px;margin:0 auto;"
    ></div>
  </div>
</div>

<script>
(function () {
  var host = document.getElementById('judgeme_product_reviews');
  if (!host) return;
  var Q = [/^questions?\s*(?:&|and|,)?\s*answers?$/i, /^ask a question$/i, /^be the first to ask/i, /^customer questions$/i, /^q\s*&\s*a$/i];
  function rm(el) { if (el && el.parentNode) el.parentNode.removeChild(el); }
  function hit(txt) {
    var t = txt.trim().replace(/\s+/g, ' ');
    if (!t || t.length > 60) return false;
    return Q.some(function (r) { return r.test(t); });
  }
  function clean() {
    host.querySelectorAll('[class*="question-item"], [class*="qna"], [class*="custom-answer-list"], .jdgm-tabs [role="tab"]').forEach(function (el) {
      if (el.matches('.jdgm-tabs [role="tab"]')) { if (hit(el.textContent)) rm(el); return; }
      rm(el);
    });
    host.querySelectorAll('h1,h2,h3,h4,button,[role="heading"]').forEach(function (el) {
      if (hit(el.textContent)) rm(el);
    });
  }
  clean();
  var mo = new MutationObserver(clean);
  mo.observe(host, { childList: true, subtree: true });
  setTimeout(function () { mo.disconnect(); }, 30000);
})();
</script>

{% schema %}
{
  "name": "Customer reviews",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Displays the Judge.me review widget for this product."
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to show only the Judge.me review widget."
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "hxl",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "hxxl",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-4"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}