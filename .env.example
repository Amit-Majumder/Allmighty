# Shopify CLI environment variables for this theme project.
# Copy this file to `.env` and fill in real values. `.env` is gitignored — never commit it.

# Store URL. Use the full myshopify.com URL or just the prefix.
# From: Shopify admin -> the URL bar while logged in (https://<store>.myshopify.com/admin)
SHOPIFY_FLAG_STORE=your-store.myshopify.com

# Theme access token. Used to authenticate the CLI non-interactively.
# To create one:
#   1. Install the free "Theme Access" app from the Shopify App Store:
#      https://apps.shopify.com/theme-access
#   2. In the app -> "Create theme password" -> enter your email -> "Create password"
#   3. Open the emailed link (expires in 7 days). The password is shown only ONCE.
#   4. Paste that token below. It normally starts with shptka_ or shpat_.
SHOPIFY_CLI_THEME_TOKEN=shptka_...

# Only needed if your storefront is password-protected.
# From: Shopify admin -> Online Store -> Preferences -> Password protection
# SHOPIFY_FLAG_STORE_PASSWORD=your-storefront-password

# Optional: pin a specific remote theme by ID (get it with `shopify theme list`).
# Leave unset to use the live theme (--live).
# SHOPIFY_FLAG_THEME_ID=123456789012
