            "custom_liquid": "{%- comment -%}\n  PRODUCT SPECIFICATIONS\n  Shopify Category Metafields\n  Category: Earrings\n{%- endcomment -%}\n\n{%- assign color = product.metafields.shopify.color-pattern -%}\n{%- assign jewelry_material = product.metafields.shopify.jewelry-material -%}\n{%- assign age_group = product.metafields.shopify.age-group -%}\n{%- assign earring_closure = product.metafields.shopify.earring-closure-type -%}\n{%- assign earring_design = product.metafields.shopify.earring-design -%}\n{%- assign jewelry_type = product.metafields.shopify.jewelry-type -%}\n{%- assign metal_purity = product.metafields.shopify.metal-purity -%}\n{%- assign target_gender = product.metafields.shopify.target-gender -%}\n\n\n{%- capture specifications -%}\n\n  {%- if color.value != blank -%}\n    <div class=\"specification-row\">\n      <span class=\"specification-label\">Color</span>\n      <span class=\"specification-value\">\n        {%- for item in color.value -%}\n          {{ item.label }}{% unless forloop.last %}, {% endunless %}\n        {%- endfor -%}\n      </span>\n    </div>\n  {%- endif -%}\n\n\n  {%- if jewelry_material.value != blank -%}\n    <div class=\"specification-row\">\n      <span class=\"specification-label\">Jewelry Material</span>\n      <span class=\"specification-value\">\n        {%- for item in jewelry_material.value -%}\n          {{ item.label }}{% unless forloop.last %}, {% endunless %}\n        {%- endfor -%}\n      </span>\n    </div>\n  {%- endif -%}\n\n\n  {%- if age_group.value != blank -%}\n    <div class=\"specification-row\">\n      <span class=\"specification-label\">Age Group</span>\n      <span class=\"specification-value\">\n        {%- for item in age_group.value -%}\n          {{ item.label }}{% unless forloop.last %}, {% endunless %}\n        {%- endfor -%}\n      </span>\n    </div>\n  {%- endif -%}\n\n\n  {%- if earring_closure.value != blank -%}\n    <div class=\"specification-row\">\n      <span class=\"specification-label\">Earring Closure Type</span>\n      <span class=\"specification-value\">\n        {%- for item in earring_closure.value -%}\n          {{ item.label }}{% unless forloop.last %}, {% endunless %}\n        {%- endfor -%}\n      </span>\n    </div>\n  {%- endif -%}\n\n\n  {%- if earring_design.value != blank -%}\n    <div class=\"specification-row\">\n      <span class=\"specification-label\">Earring Design</span>\n      <span class=\"specification-value\">\n        {%- for item in earring_design.value -%}\n          {{ item.label }}{% unless forloop.last %}, {% endunless %}\n        {%- endfor -%}\n      </span>\n    </div>\n  {%- endif -%}\n\n\n  {%- if jewelry_type.value != blank -%}\n    <div class=\"specification-row\">\n      <span class=\"specification-label\">Jewelry Type</span>\n      <span class=\"specification-value\">\n        {%- for item in jewelry_type.value -%}\n          {{ item.label }}{% unless forloop.last %}, {% endunless %}\n        {%- endfor -%}\n      </span>\n    </div>\n  {%- endif -%}\n\n\n  {%- if metal_purity.value != blank -%}\n    <div class=\"specification-row\">\n      <span class=\"specification-label\">Metal Purity</span>\n      <span class=\"specification-value\">\n        {%- for item in metal_purity.value -%}\n          {{ item.label }}{% unless forloop.last %}, {% endunless %}\n        {%- endfor -%}\n      </span>\n    </div>\n  {%- endif -%}\n\n\n  {%- if target_gender.value != blank -%}\n    <div class=\"specification-row\">\n      <span class=\"specification-label\">Target Gender</span>\n      <span class=\"specification-value\">\n        {%- for item in target_gender.value -%}\n          {{ item.label }}{% unless forloop.last %}, {% endunless %}\n        {%- endfor -%}\n      </span>\n    </div>\n  {%- endif -%}\n\n{%- endcapture -%}\n\n\n{%- assign specifications_clean = specifications | strip -%}\n\n{%- if specifications_clean != blank -%}\n\n  <details class=\"product__accordion accordion quick-add-hidden\">\n\n    <summary role=\"button\" aria-expanded=\"false\">\n\n      <div class=\"summary__title\">\n        <h2 class=\"h4 accordion__title inline-richtext\">\n          Specifications\n        </h2>\n      </div>\n\n      {{ 'icon-caret.svg' | inline_asset_content }}\n\n    </summary>\n\n\n    <div class=\"accordion__content specifications-container\">\n\n      {{ specifications }}\n\n    </div>\n\n  </details>\n\n\n  <style>\n\n    .specifications-container {\n      width: 100%;\n      padding-top: 8px;\n      padding-bottom: 12px;\n    }\n\n    .specification-row {\n      display: flex;\n      justify-content: space-between;\n      align-items: flex-start;\n      gap: 24px;\n\n      padding: 11px 0;\n\n      border-bottom: 1px solid rgba(var(--color-foreground), 0.10);\n    }\n\n    .specification-row:last-child {\n      border-bottom: none;\n    }\n\n    .specification-label {\n      flex: 0 0 45%;\n      font-weight: 600;\n      line-height: 1.5;\n    }\n\n    .specification-value {\n      flex: 1;\n\n      text-align: right;\n      line-height: 1.5;\n\n      opacity: 0.85;\n    }\n\n\n    @media screen and (max-width: 749px) {\n\n      .specification-row {\n        gap: 16px;\n        padding: 10px 0;\n      }\n\n      .specification-label {\n        flex: 0 0 48%;\n      }\n\n    }\n\n  </style>\n\n{%- endif -%}"
